rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Site settings document (publicly readable so all visitors see live phone/address, writable for admin updates)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Bookings collection (users can submit consultation requests, admins can manage them)
    match /bookings/{bookingId} {
      allow read, create, update, delete: if true;
    }

    // Dynamic countries, visa forms, and nav menus collections
    match /countries/{countryId} {
      allow read, write: if true;
    }

    match /forms/{formId} {
      allow read, write: if true;
    }

    match /menus/{menuId} {
      allow read, write: if true;
    }
  }
}
